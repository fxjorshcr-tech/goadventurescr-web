# Resend Configuration
# Get your API key at https://resend.com/api-keys (it's free!)
RESEND_API_KEY=re_xxxxxxxxx

# Email where contact form messages will be sent
CONTACT_EMAIL=info@goadventurescr.com

# PayPal Configuration
# Get your credentials from: https://developer.paypal.com/dashboard/applications/sandbox
# For production, use your live credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# PayPal mode: 'sandbox' for testing, 'live' for production
PAYPAL_MODE=sandbox
