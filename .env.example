# Zoho Mail SMTP Configuration
# These credentials are used to send emails from the contact forms

# Your Zoho email address (e.g., info@goadventurescr.com)
ZOHO_EMAIL=info@goadventurescr.com

# Your Zoho email password or App-Specific Password
# If you have 2FA enabled, you need to create an App-Specific Password:
# 1. Go to accounts.zoho.com
# 2. Security > App Passwords
# 3. Generate a new password for this application
ZOHO_PASSWORD=your_zoho_password_here

# PayPal Configuration
# Get your Client ID from: https://developer.paypal.com/dashboard/applications/sandbox
# For production, use your live Client ID
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
